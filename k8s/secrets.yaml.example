# EXAMPLE SECRETS TEMPLATE - DO NOT COMMIT REAL PRODUCTION SECRETS
# In production, inject secrets via ExternalSecrets, Vault, AWS Secrets Manager, or SealedSecrets.
# To deploy manually for testing: copy to secrets.yaml, replace placeholders, and apply.
apiVersion: v1
kind: Secret
metadata:
  name: cerberus-secrets
  namespace: cerberus
  labels:
    app.kubernetes.io/name: cerberus-api
    app.kubernetes.io/part-of: cerberus-system
type: Opaque
stringData:
  # High-entropy production secret key (min 32 characters)
  SECRET_KEY: "REPLACE_WITH_HIGH_ENTROPY_RANDOM_HEX_STRING_MIN_32_CHARS"
  # Production database connection URL (e.g. Postgres asyncpg)
  DATABASE_URL: "postgresql+asyncpg://cerberus_user:REPLACE_WITH_DB_PASSWORD@cerberus-postgres.cerberus.svc.cluster.local:5432/cerberus_db"
  # GitHub App or webhook HMAC secret
  GITHUB_WEBHOOK_SECRET: "REPLACE_WITH_GITHUB_WEBHOOK_HMAC_SECRET"
  # LLM Provider Keys (at least one production provider or self-hosted model)
  OPENAI_API_KEY: ""
  ANTHROPIC_API_KEY: ""
  GEMINI_API_KEY: ""
  GROQ_API_KEY: ""
  DEEPSEEK_API_KEY: ""
