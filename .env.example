# ============================================================
# cerberus</> Autonomous Multi-Agent Code Review Configuration
# ============================================================

# ------------------------------------------------------------
# 1. Server & Security Configuration
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret key for tokens and cryptographic hash operations
# In production, must be at least 32 characters of high-entropy randomness:
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cerberus_dev_secret_key_change_in_production_32chars
API_KEY_PREFIX=cvai_
RATE_LIMIT_PER_HOUR=1000

# GitHub Webhook Security
GITHUB_WEBHOOK_SECRET=
# In non-local environments, GITHUB_WEBHOOK_SECRET is strictly required.
# In local development only, ALLOW_INSECURE_LOCAL_WEBHOOKS can be set to true for debugging:
ALLOW_INSECURE_LOCAL_WEBHOOKS=false

# Source Code Privacy & Data Retention
RETAIN_SOURCE_CODE=false
DATA_RETENTION_DAYS=30

# Database Configuration (SQLite default for zero-config, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./cerberus.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://cerberus:your_production_password@localhost:5432/cerberus_db

# Cache Configuration (Falls back to high-performance in-memory LRU if Redis is absent)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800

# ------------------------------------------------------------
# 2. Multi-Agent Collaboration Engine
# ------------------------------------------------------------
# Active review agents (domain specialists)
ENABLED_AGENTS=security,performance,quality,architecture,compliance

# Enable Collaborative Consensus and Unified Patch generation across agents
COLLABORATIVE_MODE=true

# Severity & Blocking Thresholds
SEVERITY_THRESHOLD=medium
BLOCKING_MODE=false

# ------------------------------------------------------------
# 3. LLM Providers & API Keys (Choose Any or Mix & Match)
# ------------------------------------------------------------
# Provider selection mode:
# - "auto" (default): Automatically detects any configured key in priority:
#                     Groq -> OpenAI -> Anthropic -> Gemini -> DeepSeek -> Ollama -> Watsonx -> Heuristic
# - "groq", "openai", "anthropic", "gemini", "deepseek", "ollama", "heuristic", "watsonx"
LLM_PROVIDER=auto

# --- Groq (Ultra-fast: https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (Fast & free tier: https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI (GPT-4o, GPT-4o-mini: https://platform.openai.com) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic (Claude 3.5 Sonnet: https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- DeepSeek (DeepSeek-V3, DeepSeek-R1: https://platform.deepseek.com) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Ollama (100% Free, Local, Offline: https://ollama.ai) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama
